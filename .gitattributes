# Keep large binary source artifacts out of regular Git object history.
*.zip filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
*.xls filter=lfs diff=lfs merge=lfs -text
*.xlsx filter=lfs diff=lfs merge=lfs -text
*.shp filter=lfs diff=lfs merge=lfs -text
*.shx filter=lfs diff=lfs merge=lfs -text
*.dbf filter=lfs diff=lfs merge=lfs -text

# Preserve readable diffs for the atlas and generated result slices.
*.html text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.py text eol=lf
*.json text eol=lf
*.csv -text
*.md text eol=lf
